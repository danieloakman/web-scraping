{
  "name": "web-scraping",
  "version": "0.1.0",
  "description": "Web scraping",
  "type": "module",
  "scripts": {
    "build": "sst build --stage prod",
    "check": "tsc --noEmit",
    "cleaninstall": "rm -rf node_modules .sst",
    "deploy": "sst deploy --stage prod",
    "dev": "sst dev",
    "format": "prettier --write ./src && eslint --fix ./src",
    "lint": "prettier --check ./src && eslint ./src",
    "test": "bun test",
    "test:dev": "bunx sst dev -- bun test",
    "remove": "sst remove --stage prod",
    "upgrade-interactive": "bunx npm-check-updates -i"
  },
  "author": "Daniel Brown",
  "dependencies": {
    "@danoaky/js-utils": "^0.31.1",
    "@sparticuz/chromium": "^149",
    "http-status-codes": "^2.3.0",
    "iteragain": "^4.2.1",
    "playwright-core": "1.61",
    "sst": "^4.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@playwright/test": "1.61",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/aws-lambda": "^8.10.162",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "chromium": "^3.0.3",
    "meow": "^14.1.0",
    "npm-check-updates": "^23.0.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}